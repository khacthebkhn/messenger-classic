{
  "name": "messenger-classic",
  "productName": "Messenger Classic",
  "version": "1.4.0",
  "description": "Desktop Messenger with the late messenger.com look, without the rest of Facebook",
  "main": "src/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --dir --publish never",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.messengerclassic.desktop",
    "productName": "Messenger Classic",
    "executableName": "MessengerClassic",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Messenger Classic",
      "artifactName": "MessengerClassic-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MessengerClassic-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "artifactName": "MessengerClassic-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSCameraUsageDescription": "Messenger Classic uses the camera for video calls.",
        "NSMicrophoneUsageDescription": "Messenger Classic uses the microphone for calls and voice messages."
      }
    },
    "dmg": {
      "artifactName": "MessengerClassic-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "khacthebkhn",
        "repo": "messenger-classic",
        "releaseType": "release"
      }
    ],
    "asar": true
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
